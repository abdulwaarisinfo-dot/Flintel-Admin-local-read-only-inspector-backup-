# ---- Option A: a single URL (if Render gives you one) ----
# DATABASE_URL=mysql://flintel_user:PASSWORD@HOST:PORT/flintel

# ---- Option B: individual values (used when DATABASE_URL is empty) ----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=flintel
MYSQL_USER=flintel_user
MYSQL_PASSWORD=
# Not used by this tool (it never needs root). Leave blank.
MYSQL_ROOT_PASSWORD=

# ---- Admin login for this tool ----
ADMIN_PASSWORD=
# Optional: keeps you logged in across restarts. Any long random string.
SESSION_SECRET=

# ---- Optional ----
# Set to true if your MySQL server requires TLS
MYSQL_SSL=false
# Full path to mysqldump.exe if it is not on PATH, e.g.
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQLDUMP_PATH=

# Optional: sirf in tables ka backup (comma separated). Khali = saare tables.
# Misal: sirf Hacker News ka backup -> BACKUP_TABLES=hacker_news
BACKUP_TABLES=

# ---- Hacker News (optional) ----
# DATABASE naam jis mein HN ka table hai. Khali = wahi database jis se connect hain (MYSQL_DATABASE).
HN_MYSQL_DATABASE=
# TABLE (collection) ka naam. Default: hacker_news
HN_MYSQL_TABLE=hacker_news
# Backup mein doosre database ka table chahiye to:  BACKUP_TABLES=otherdb.hacker_news

# ---- Main messages table (Reddit/Twitter) : DATABASE + TABLE dono set kar sakte hain ----
# Khali database = wahi jis se connect hain (MYSQL_DATABASE)
SIGNALS_MYSQL_DATABASE=
SIGNALS_MYSQL_TABLE=flintel_signals
